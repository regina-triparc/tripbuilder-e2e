TBA_E2E_EMAIL=
TBA_E2E_PASSWORD=

# Optional — enables DB-ground-truth assertions in ui/search.spec.ts and
# api/pim-itinerary-search.spec.ts (checked against stockroom.products).
# Only reachable from the corporate VPN (Atlas PrivateLink) — leave unset
# to skip these checks and run with API-only coverage.
PIM_MONGODB_URI=

# Optional — enables the TB-271 traveler-info event checks in
# traveler/traveler-info-event.spec.ts (`npm run e2e:traveler`). The whole
# describe block skips when unset, so leaving it blank costs you nothing.
#
# Value comes from Azure Key Vault, verbatim, no reformatting needed:
#   az keyvault secret show --vault-name triparc-shared-dev-kv \
#     --name "TripArcMakePayable--ConnectionStrings--Default" --query value -o tsv
#
# Accepts the .NET keyword form (Server=…;Database=…;User Id=…;Password=…) as
# stored, or a postgresql:// URI. Prefer pasting the keyword form: converting
# by hand is how passwords containing `@` get mangled.
#
# Corporate VPN only — the server is behind a private endpoint (10.x address,
# no public DNS A record). Sessions are forced read-only by the helper.
MAKE_PAYABLE_POSTGRES_URI=

# Optional. Pins the payload-vs-read-model check to one specific offer, e.g.
# after attaching travelers by hand in the UI. Unset, the spec falls back to
# whichever offer most recently produced an event.
TB271_OFFER_ID=

# --- TB-271 UI-driven suite (`npm run e2e:traveler-ui`) ---
# A dev trip that ALREADY HAS AN OFFER. The suite drives the real Travelers tab
# on this trip and adds travelers to it, so use a trip of your own — not a
# colleague's fixture. It deliberately does not create the trip itself: that
# means search + add-to-quote + the offer wizard, and a failure there would be
# indistinguishable from a traveller failure.
TB271_TRIP_ID=

# Which client to attach — matched against the add-client sheet's search.
TB271_CLIENT_SEARCH=Cartman

# Which app to drive: `tsp` (default) hits /tsp/:tripId/travellers, which is
# where the /trips dashboard actually navigates. `trip` hits
# /trips/:tripId/travelers (apps/trip). Note the one-L vs two-L spelling — the
# wrong one renders a blank page with no error.
TB271_APP=tsp

# Optional, for case 5 (attach with "Is travelling" OFF). Needs a SECOND trip
# with an offer and NO client attached yet, because a client is locked to an
# offer once attached. Skips when unset.
TB271_FRESH_TRIP_ID=

# --- TB-271 Service Bus leg (optional; skips until it exists) ---
# Peek-only verification that the event really reached the broker. Needs a QA
# subscription filtering on Label `trip.make-payable.traveler-info` with NO
# consumer attached — see e2e/traveler/README.md for the two az commands.
# Auth is DefaultAzureCredential, so `az login` is enough, but the identity
# needs the "Azure Service Bus Data Receiver" role on the namespace.
MAKE_PAYABLE_SB_NAMESPACE=triparc-tripbuilder-shared-sb-01
MAKE_PAYABLE_SB_SUBSCRIPTION=

# --- Xray Cloud results upload (optional) ---
# Leave XRAY_CLIENT_ID / XRAY_CLIENT_SECRET / XRAY_PROJECT_KEY unset and the
# reporter no-ops with a warning — a full local run needs none of this.
# Create the key pair in Jira: Apps -> Xray -> API Keys.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=

# Optional. Set to append every run to one existing Test Execution issue
# instead of Xray creating a fresh one per run.
XRAY_TEST_EXECUTION_KEY=
# Optional. Links the created Test Execution to a Test Plan.
XRAY_TEST_PLAN_KEY=
# Optional. Free-text environment label shown on the execution (e.g. UAT).
XRAY_TEST_ENVIRONMENT=UAT

# Set to `false` to send test-level evidence only, skipping step results.
# Useful while the manual steps defined on the Xray Test issues don't yet
# line up 1:1 with the spec's test.step() blocks — Xray matches them
# positionally, so a mismatch attaches evidence to the wrong step.
XRAY_STEP_RESULTS=

# Overrides the parallel worker count (default 4). The api project's rows hit
# a real LLM-backed agent, so raise until trip-agents rate-limits.
E2E_WORKERS=

# ── pdp project (e2e/pdp) ───────────────────────────────────────────────────
# PDP price-rail party composition + start date. Runs with NO configuration by
# taking the search-results route to the default package below, but pin the
# slug for a stable run — the search leg is LLM-backed and ranking can move.
# Run with: npm run e2e:pdp-headed

# Goes straight to /pdp?template=<slug>, skipping search entirely. Leave this
# commented out to use the verified default, `rome-luxe-6day-culture`
# ("Rome In Style"). Set it to an EMPTY value to force the search route below.
# TB_PDP_TEMPLATE_SLUG=rome-luxe-6day-culture

# Fallback route, used only when TB_PDP_TEMPLATE_SLUG is set but empty: search
# for this query and open the card whose title matches, or the first result.
# Note the shipped default query returned ZERO packages in UAT on 2026-09-15 —
# curated ranking is LLM-backed, so prefer the pinned slug above.
TB_PDP_TEMPLATE_TITLE=Rome In Style
TB_PDP_SEARCH_QUERY=Rome

# Optional. An MM/DD/YYYY date that IS a blackout date for the package above.
# Unset, the blackout case in pdp-start-date.spec.ts skips rather than
# asserting a rule it cannot verify.
TB_PDP_BLACKOUT_DATE=

# ── services-hotel project (e2e/services/hotel) ─────────────────────────────
# Every case skips when its variable is unset, so a routine run cannot touch a
# trip by accident. Run with: npm run e2e:hotel-headed

# A dev trip that already has a hotel service. Drives every NON-destructive
# case: the itinerary lifecycle reads, and the room-type modify cases that stop
# short of committing.
# For the room-type cases to assert anything, the hotel must return MORE THAN
# ONE room for the trip's dates — with a single room on offer there is nothing
# to switch between and those cases report it rather than passing silently.
TB_HOTEL_TRIP_ID=

# A THROWAWAY trip whose hotel service may be DESTROYED. Gates the delete case
# in hotel-service-lifecycle.spec.ts. Deliberately a second variable so a
# routine run cannot delete a service.
TB_HOTEL_DESTRUCTIVE_TRIP_ID=

# A THROWAWAY trip whose hotel ROOM may be swapped. Gates the commit case in
# hotel-room-modify.spec.ts, which issues a real replace-from-pick against the
# Shopping Gateway. Separate from the delete variable above so enabling one
# does not enable the other.
TB_HOTEL_MODIFY_TRIP_ID=

# Row-name fragment used to find the hotel row on the itinerary (default
# `Hotel`). Hotel rows are named after the property, so set this to part of the
# property name when the trip has several hotels and you need a specific one.
TB_HOTEL_SERVICE_NAME=

# Target environment for the UI (and the BFF at <BASE_URL>/bff/api/ unless API_BASE_URL is set)
BASE_URL=https://tripbuilder.dev.triparcdev.com/
# API_BASE_URL=
